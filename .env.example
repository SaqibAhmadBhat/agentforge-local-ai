# AgentForge configuration example.
# Copy this file to `.env` and change only what you need; blank lines use the defaults.
# There are NO API keys or secrets: AgentForge only talks to Ollama on this computer.

# Ollama model to use (must appear in `ollama list`). Cloud models (*-cloud) are refused.
AGENTFORGE_MODEL=qwen3:4b

# Where the local Ollama server listens. Only this computer (localhost/127.0.0.1) is
# allowed unless AGENTFORGE_ALLOW_REMOTE_OLLAMA=true, because a remote server would
# receive your prompts and notes.
AGENTFORGE_OLLAMA_URL=http://127.0.0.1:11434
AGENTFORGE_ALLOW_REMOTE_OLLAMA=false

# Seconds to wait for one model reply. The first reply loads the model and is slow on CPU.
AGENTFORGE_TIMEOUT_SECONDS=180

# Agent loop limits.
AGENTFORGE_MAX_ITERATIONS=6
AGENTFORGE_MAX_TOOL_CALLS_PER_STEP=4

# Size limits (characters / tokens).
AGENTFORGE_MAX_INPUT_CHARS=4000
AGENTFORGE_MAX_TOOL_RESULT_CHARS=2000
AGENTFORGE_MAX_OUTPUT_TOKENS=2048

# How many previous question/answer pairs are kept as context (0 = none). Never saved to disk.
AGENTFORGE_HISTORY_TURNS=4

# Thinking mode for reasoning models such as qwen3. `false` is faster on slow laptops and
# is required for models without thinking support (e.g. llama3.2:3b).
AGENTFORGE_THINK=true

# GPU layers for Ollama. Blank = let Ollama decide. 0 = CPU only (fixes
# "CUDA error: device kernel image is invalid" on older NVIDIA drivers).
AGENTFORGE_NUM_GPU=

# Folder for notes (relative paths are inside the project folder). Ignored by Git.
AGENTFORGE_DATA_DIR=data

# Port for the optional local web interface (`agentforge --web`). It always listens on
# 127.0.0.1 only, so other computers cannot connect to it.
AGENTFORGE_WEB_PORT=8765
